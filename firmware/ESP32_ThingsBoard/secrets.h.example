#ifndef PUMP_GATEWAY_SECRETS_H
#define PUMP_GATEWAY_SECRETS_H
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
#define THINGSBOARD_TOKEN "YOUR_DEVICE_ACCESS_TOKEN"
#define THINGSBOARD_HOST "mqtt.thingsboard.cloud"
#define MQTT_USE_TLS 1
#define THINGSBOARD_PORT 8883
/* The default trusted_roots.h contains public Amazon/ISRG/DigiCert roots.
 * If your broker uses another root, override THINGSBOARD_ROOT_CA with its
 * trusted PEM here. Otherwise leave this macro undefined to use the bundle.
 * Do not define an empty CA or use setInsecure().
 * Example syntax for a CUSTOM trusted root:
 * #define THINGSBOARD_ROOT_CA R"PEM(-----BEGIN CERTIFICATE-----
 * ...actual trusted CA certificate...
 * -----END CERTIFICATE-----
 * )PEM"
 */
/* Isolated bench testing with plaintext MQTT requires an explicit choice:
 * MQTT_USE_TLS 0 and THINGSBOARD_PORT 1883. Token/commands then are unencrypted.
 * Do not use setInsecure().
 */
#endif
